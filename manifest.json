{
  "manifest_version": 3,
  "name": "PinPoint Feedback",
  "short_name": "PinPoint",
  "version": "1.0.0",
  "description": "Click anywhere on a website, pin a comment, export a PDF punch list. No account. Nothing leaves your device.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PinPoint Feedback: comment on this page (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Turn comment mode on or off"
    }
  },
  "options_page": "dashboard/dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
